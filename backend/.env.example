# ============================================================
# Application
# ============================================================
NODE_ENV=development
APP_PORT=3000
APP_NAME=GRH-EMMN
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ============================================================
# Base de donnees PostgreSQL
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root1234
DB_DATABASE=grh_emmn
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_SECRET=change_me_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# Securite
# ============================================================
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ============================================================
# Stockage de fichiers
# ============================================================
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Pour STORAGE_DRIVER=s3 en production
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ============================================================
# Import Excel
# ============================================================
IMPORT_MAX_ROWS=2000
IMPORT_SYNC_THRESHOLD=500